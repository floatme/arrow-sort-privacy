{
  "manifest_version": 3,
  "name": "AElinkGenerator",
  "version": "1.0.0",
  "description": "Turn AliExpress product URLs into affiliate links using your open Portals Link Generator tab.",
  "permissions": ["tabs", "alarms", "storage", "scripting"],
  "host_permissions": [
    "https://portals.aliexpress.com/*",
    "https://star.aliexpress.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AElinkGenerator",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portals.aliexpress.com/*link_generator*",
        "https://portals.aliexpress.com/affiportals/web/link_generator.htm*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://portals.aliexpress.com/*", "https://star.aliexpress.com/*"]
    }
  ]
}
